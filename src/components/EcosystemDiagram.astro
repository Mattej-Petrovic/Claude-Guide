---
// Static SVG diagram of the Claude ecosystem layers.
// Colors are hardcoded from global.css tokens — CSS custom properties
// don't resolve inside static SVG.
---

<figure class="ecosystem-diagram" aria-label="Claude ecosystem layers diagram">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 1400 920"
    role="img"
    aria-labelledby="eco-title eco-desc"
  >
    <title id="eco-title">The Claude Ecosystem</title>
    <desc id="eco-desc">
      A layered diagram showing the Claude ecosystem from bottom to top:
      the API and model at the base, Products in the middle (Claude.ai, Code,
      Cowork, Chrome, Excel, Design, Dispatch, Phone), a cross-cutting
      Capabilities band (Memory, Projects, Artifacts, Research, Subagents,
      Hooks, Output Styles, Permissions), and the Extension layer at the top
      (Skills, MCP, Connectors, Plugins, Commands) with a third-party
      ecosystem annotation.
    </desc>

    <!-- ── Background ── -->
    <rect width="1400" height="920" fill="#202426" />

    <!-- ── Diagram header ── -->
    <text x="700" y="46" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="19" font-weight="500" letter-spacing="0.10em" fill="#525a57">THE CLAUDE ECOSYSTEM</text>
    <line x1="24" y1="62" x2="1376" y2="62" stroke="rgba(255,255,255,0.06)" stroke-width="1" />

    <!-- ════════════════════════════════════════════
         LAYER 4 — Extension layer (top)
         5 tiles × 220px wide, 14px gap → 5×220 + 4×14 = 1156, start x=24
         tile height=100, y=108, bottom=208
         title y=152, subtitle y=185
    ═══════════════════════════════════════════════ -->
    <text x="24" y="94" font-family="'Outfit',system-ui,sans-serif" font-size="16" font-weight="500" letter-spacing="0.10em" fill="#525a57">EXTENSION LAYER</text>

    <!-- Skills: x=24, center=134 -->
    <rect x="24"  y="108" width="220" height="100" rx="6" fill="#323839" stroke="rgba(255,255,255,0.10)" stroke-width="1" />
    <text x="134" y="152" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="23" font-weight="600" fill="#d4d9d6">Skills</text>
    <text x="134" y="185" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="17" fill="#525a57">instruction sets</text>

    <!-- MCP: x=258, center=368 -->
    <rect x="258" y="108" width="220" height="100" rx="6" fill="#323839" stroke="rgba(255,255,255,0.10)" stroke-width="1" />
    <text x="368" y="152" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="23" font-weight="600" fill="#d4d9d6">MCP</text>
    <text x="368" y="185" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="17" fill="#525a57">tool connections</text>

    <!-- Connectors: x=492, center=602 -->
    <rect x="492" y="108" width="220" height="100" rx="6" fill="#323839" stroke="rgba(255,255,255,0.10)" stroke-width="1" />
    <text x="602" y="152" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="23" font-weight="600" fill="#d4d9d6">Connectors</text>
    <text x="602" y="185" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="17" fill="#525a57">pre-built MCP</text>

    <!-- Plugins: x=726, center=836 -->
    <rect x="726" y="108" width="220" height="100" rx="6" fill="#323839" stroke="rgba(255,255,255,0.10)" stroke-width="1" />
    <text x="836" y="152" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="23" font-weight="600" fill="#d4d9d6">Plugins</text>
    <text x="836" y="185" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="17" fill="#525a57">bundled packages</text>

    <!-- Commands: x=960, center=1070 -->
    <rect x="960" y="108" width="220" height="100" rx="6" fill="#323839" stroke="rgba(255,255,255,0.10)" stroke-width="1" />
    <text x="1070" y="152" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="23" font-weight="600" fill="#d4d9d6">Commands</text>
    <text x="1070" y="185" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="17" fill="#525a57">reusable prompts</text>

    <!-- Third-party annotation box: x=1198, width=178, center=1287 -->
    <rect x="1198" y="100" width="178" height="130" rx="6" fill="rgba(255,255,255,0.02)" stroke="rgba(255,255,255,0.09)" stroke-width="1" stroke-dasharray="5 4" />
    <text x="1287" y="132" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="19" font-weight="500" fill="#525a57">Third-party</text>
    <text x="1287" y="155" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="19" font-weight="500" fill="#525a57">ecosystem</text>
    <text x="1287" y="178" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="17" fill="#525a57">community skills,</text>
    <text x="1287" y="201" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="17" fill="#525a57">MCP servers, plugins</text>

    <!-- arrow from Commands tile to third-party box -->
    <line x1="1180" y1="158" x2="1198" y2="158" stroke="rgba(255,255,255,0.14)" stroke-width="1" />
    <polygon points="1194,153 1202,158 1194,163" fill="rgba(255,255,255,0.20)" />

    <!-- connector: extension down to capabilities -->
    <line x1="602" y1="208" x2="602" y2="312" stroke="rgba(255,255,255,0.05)" stroke-width="1" stroke-dasharray="4 4" />

    <!-- ════════════════════════════════════════════
         LAYER 3 — Capabilities (cross-cutting band)
         y=312, height=180, bottom=492
         band width=1352 (x=24 to 1376)
         4 pills × 270px wide, 18px gap → 4×270+3×18=1134, start x=44
         pill height=46, row1 y=354, row2 y=412
    ═══════════════════════════════════════════════ -->
    <rect x="24" y="312" width="1352" height="180" rx="6" fill="rgba(126,184,154,0.07)" stroke="rgba(126,184,154,0.25)" stroke-width="1" />

    <text x="44" y="342" font-family="'Outfit',system-ui,sans-serif" font-size="16" font-weight="500" letter-spacing="0.09em" fill="#7eb89a">CAPABILITIES — cross-cutting, availability varies by product</text>

    <!-- Row 1: y=354, height=46, text at y=383 -->
    <rect x="44"  y="354" width="270" height="46" rx="5" fill="rgba(126,184,154,0.06)" stroke="rgba(126,184,154,0.18)" stroke-width="1" />
    <text x="179" y="383" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="19" fill="#9aa49f">Memory</text>

    <rect x="332" y="354" width="270" height="46" rx="5" fill="rgba(126,184,154,0.06)" stroke="rgba(126,184,154,0.18)" stroke-width="1" />
    <text x="467" y="383" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="19" fill="#9aa49f">Projects</text>

    <rect x="620" y="354" width="270" height="46" rx="5" fill="rgba(126,184,154,0.06)" stroke="rgba(126,184,154,0.18)" stroke-width="1" />
    <text x="755" y="383" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="19" fill="#9aa49f">Artifacts</text>

    <rect x="908" y="354" width="270" height="46" rx="5" fill="rgba(126,184,154,0.06)" stroke="rgba(126,184,154,0.18)" stroke-width="1" />
    <text x="1043" y="383" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="19" fill="#9aa49f">Research</text>

    <!-- Row 2: y=412, height=46, text at y=441 -->
    <rect x="44"  y="412" width="270" height="46" rx="5" fill="rgba(126,184,154,0.06)" stroke="rgba(126,184,154,0.18)" stroke-width="1" />
    <text x="179" y="441" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="19" fill="#9aa49f">Subagents</text>

    <rect x="332" y="412" width="270" height="46" rx="5" fill="rgba(126,184,154,0.06)" stroke="rgba(126,184,154,0.18)" stroke-width="1" />
    <text x="467" y="441" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="19" fill="#9aa49f">Hooks</text>

    <rect x="620" y="412" width="270" height="46" rx="5" fill="rgba(126,184,154,0.06)" stroke="rgba(126,184,154,0.18)" stroke-width="1" />
    <text x="755" y="441" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="19" fill="#9aa49f">Output Styles</text>

    <rect x="908" y="412" width="270" height="46" rx="5" fill="rgba(126,184,154,0.06)" stroke="rgba(126,184,154,0.18)" stroke-width="1" />
    <text x="1043" y="441" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="19" fill="#9aa49f">Permissions</text>

    <!-- connector: capabilities down to products -->
    <line x1="700" y1="492" x2="700" y2="604" stroke="rgba(126,184,154,0.20)" stroke-width="1" stroke-dasharray="4 3" />

    <!-- ════════════════════════════════════════════
         LAYER 2 — Products
         8 tiles × 158px wide, 12px gap → 8×158+7×12=1348, start x=24
         height=100, y=608, title y=648, subtitle y=677, bottom=708
    ═══════════════════════════════════════════════ -->
    <text x="24" y="596" font-family="'Outfit',system-ui,sans-serif" font-size="16" font-weight="500" letter-spacing="0.10em" fill="#525a57">PRODUCTS</text>

    <!-- Claude.ai: x=24, center=103 -->
    <rect x="24"  y="608" width="158" height="100" rx="6" fill="#262b2d" stroke="rgba(255,255,255,0.10)" stroke-width="1" />
    <text x="103" y="648" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="19" font-weight="600" fill="#d4d9d6">Claude.ai</text>
    <text x="103" y="677" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="17" fill="#525a57">chat · web · mobile</text>

    <!-- Code: x=194, center=273 -->
    <rect x="194" y="608" width="158" height="100" rx="6" fill="#262b2d" stroke="rgba(255,255,255,0.10)" stroke-width="1" />
    <text x="273" y="648" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="19" font-weight="600" fill="#d4d9d6">Code</text>
    <text x="273" y="677" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="17" fill="#525a57">terminal agent</text>

    <!-- Cowork: x=364, center=443 -->
    <rect x="364" y="608" width="158" height="100" rx="6" fill="#262b2d" stroke="rgba(255,255,255,0.10)" stroke-width="1" />
    <text x="443" y="648" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="19" font-weight="600" fill="#d4d9d6">Cowork</text>
    <text x="443" y="677" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="17" fill="#525a57">desktop tasks</text>

    <!-- Chrome: x=534, center=613 -->
    <rect x="534" y="608" width="158" height="100" rx="6" fill="#262b2d" stroke="rgba(255,255,255,0.10)" stroke-width="1" />
    <text x="613" y="648" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="19" font-weight="600" fill="#d4d9d6">Chrome</text>
    <text x="613" y="677" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="17" fill="#525a57">browser agent</text>

    <!-- Excel: x=704, center=783 -->
    <rect x="704" y="608" width="158" height="100" rx="6" fill="#262b2d" stroke="rgba(255,255,255,0.10)" stroke-width="1" />
    <text x="783" y="648" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="19" font-weight="600" fill="#d4d9d6">Excel</text>
    <text x="783" y="677" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="17" fill="#525a57">spreadsheet agent</text>

    <!-- Design: x=874, center=953 -->
    <rect x="874" y="608" width="158" height="100" rx="6" fill="#262b2d" stroke="rgba(255,255,255,0.10)" stroke-width="1" />
    <text x="953" y="648" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="19" font-weight="600" fill="#d4d9d6">Design</text>
    <text x="953" y="677" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="17" fill="#525a57">visual work</text>

    <!-- Dispatch: x=1044, center=1123 -->
    <rect x="1044" y="608" width="158" height="100" rx="6" fill="#262b2d" stroke="rgba(255,255,255,0.10)" stroke-width="1" />
    <text x="1123" y="648" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="19" font-weight="600" fill="#d4d9d6">Dispatch</text>
    <text x="1123" y="677" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="17" fill="#525a57">email · comms</text>

    <!-- Phone: x=1214, center=1293 -->
    <rect x="1214" y="608" width="158" height="100" rx="6" fill="#262b2d" stroke="rgba(255,255,255,0.10)" stroke-width="1" />
    <text x="1293" y="648" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="19" font-weight="600" fill="#d4d9d6">Phone</text>
    <text x="1293" y="677" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="17" fill="#525a57">voice calls</text>

    <!-- faint connectors from products down to API -->
    <line x1="24"   y1="708" x2="24"   y2="736" stroke="rgba(255,255,255,0.05)" stroke-width="1" />
    <line x1="1376" y1="708" x2="1376" y2="736" stroke="rgba(255,255,255,0.05)" stroke-width="1" />
    <line x1="24"   y1="736" x2="1376" y2="736" stroke="rgba(255,255,255,0.05)" stroke-width="1" />

    <!-- ════════════════════════════════════════════
         LAYER 1 — API (bottom)
         y=750, height=114, bottom=864
    ═══════════════════════════════════════════════ -->
    <rect x="24" y="750" width="1352" height="114" rx="6" fill="#2c3133" stroke="rgba(255,255,255,0.15)" stroke-width="1" />
    <text x="700" y="798" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="30" font-weight="600" fill="#d4d9d6">API</text>
    <text x="700" y="834" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="19" fill="#9aa49f">the model underneath everything</text>

    <!-- left-edge layer depth markers -->
    <line x1="10" y1="92"  x2="10" y2="208" stroke="rgba(255,255,255,0.07)" stroke-width="1" />
    <line x1="10" y1="310" x2="10" y2="492" stroke="rgba(126,184,154,0.22)" stroke-width="1" />
    <line x1="10" y1="594" x2="10" y2="708" stroke="rgba(255,255,255,0.07)" stroke-width="1" />
    <line x1="10" y1="748" x2="10" y2="864" stroke="rgba(255,255,255,0.07)" stroke-width="1" />
  </svg>
</figure>
