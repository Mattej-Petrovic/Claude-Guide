---
// Static SVG diagram of the Claude ecosystem layers.
// Colors are hardcoded from global.css tokens — CSS custom properties
// don't resolve inside static SVG.
---

<figure class="ecosystem-diagram" aria-label="Claude ecosystem layers diagram">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 1100 760"
    role="img"
    aria-labelledby="eco-title eco-desc"
  >
    <title id="eco-title">The Claude Ecosystem</title>
    <desc id="eco-desc">
      A layered diagram showing the Claude ecosystem from bottom to top:
      the API and model at the base, Products in the middle (Claude.ai, Code,
      Cowork, Chrome, Excel, Design, Dispatch, Phone), a cross-cutting
      Capabilities band (Memory, Projects, Artifacts, Research, Subagents,
      Hooks, Output Styles, Permissions), and the Extension layer at the top
      (Skills, MCP, Connectors, Plugins, Commands) with a third-party
      ecosystem annotation.
    </desc>

    <!-- ── Background ── -->
    <rect width="1100" height="760" fill="#141210" />

    <!-- ── Diagram header ── -->
    <text x="550" y="46" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="13" font-weight="500" letter-spacing="0.10em" fill="#5c5750">THE CLAUDE ECOSYSTEM</text>
    <line x1="32" y1="60" x2="1068" y2="60" stroke="rgba(255,255,255,0.05)" stroke-width="1" />

    <!-- ════════════════════════════════════════════
         LAYER 4 — Extension layer (top)
    ═══════════════════════════════════════════════ -->
    <text x="32" y="94" font-family="'Outfit',system-ui,sans-serif" font-size="12" font-weight="500" letter-spacing="0.10em" fill="#5c5750">EXTENSION LAYER</text>

    <!-- 5 tiles: each 148×72, gap 14, start x=32, total = 5×148 + 4×14 = 796px -->
    <!-- Skills -->
    <rect x="32"   y="108" width="148" height="72" rx="6" fill="#272420" stroke="rgba(255,255,255,0.09)" stroke-width="1" />
    <text x="106"  y="137" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="15" font-weight="600" fill="#e8e3db">Skills</text>
    <text x="106"  y="160" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="12" fill="#5c5750">instruction sets</text>

    <!-- MCP -->
    <rect x="194"  y="108" width="148" height="72" rx="6" fill="#272420" stroke="rgba(255,255,255,0.09)" stroke-width="1" />
    <text x="268"  y="137" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="15" font-weight="600" fill="#e8e3db">MCP</text>
    <text x="268"  y="160" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="12" fill="#5c5750">tool connections</text>

    <!-- Connectors -->
    <rect x="356"  y="108" width="148" height="72" rx="6" fill="#272420" stroke="rgba(255,255,255,0.09)" stroke-width="1" />
    <text x="430"  y="137" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="15" font-weight="600" fill="#e8e3db">Connectors</text>
    <text x="430"  y="160" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="12" fill="#5c5750">pre-built MCP</text>

    <!-- Plugins -->
    <rect x="518"  y="108" width="148" height="72" rx="6" fill="#272420" stroke="rgba(255,255,255,0.09)" stroke-width="1" />
    <text x="592"  y="137" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="15" font-weight="600" fill="#e8e3db">Plugins</text>
    <text x="592"  y="160" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="12" fill="#5c5750">bundled packages</text>

    <!-- Commands -->
    <rect x="680"  y="108" width="148" height="72" rx="6" fill="#272420" stroke="rgba(255,255,255,0.09)" stroke-width="1" />
    <text x="754"  y="137" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="15" font-weight="600" fill="#e8e3db">Commands</text>
    <text x="754"  y="160" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="12" fill="#5c5750">reusable prompts</text>

    <!-- Third-party annotation box -->
    <rect x="852"  y="100" width="184" height="88" rx="6" fill="rgba(255,255,255,0.02)" stroke="rgba(255,255,255,0.08)" stroke-width="1" stroke-dasharray="5 4" />
    <text x="944"  y="126" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="12" font-weight="500" fill="#5c5750">Third-party</text>
    <text x="944"  y="144" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="12" font-weight="500" fill="#5c5750">ecosystem</text>
    <text x="944"  y="162" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="11" fill="#5c5750">community skills,</text>
    <text x="944"  y="178" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="11" fill="#5c5750">MCP servers, plugins</text>

    <!-- arrow from Commands tile to third-party box -->
    <line x1="828" y1="144" x2="852" y2="144" stroke="rgba(255,255,255,0.12)" stroke-width="1" />
    <polygon points="848,139 856,144 848,149" fill="rgba(255,255,255,0.18)" />

    <!-- connector: extension down to capabilities -->
    <line x1="430" y1="180" x2="430" y2="348" stroke="rgba(255,255,255,0.05)" stroke-width="1" stroke-dasharray="4 4" />

    <!-- ════════════════════════════════════════════
         LAYER 3 — Capabilities (cross-cutting band)
    ═══════════════════════════════════════════════ -->
    <rect x="32" y="348" width="1036" height="138" rx="6" fill="rgba(201,169,110,0.09)" stroke="rgba(201,169,110,0.26)" stroke-width="1" />

    <text x="52" y="374" font-family="'Outfit',system-ui,sans-serif" font-size="12" font-weight="500" letter-spacing="0.09em" fill="#c9a96e">CAPABILITIES — cross-cutting, availability varies by product</text>

    <!-- Row 1 of pills: 4 pills, each 136×32, gap 14, start x=52 -->
    <rect x="52"   y="386" width="136" height="32" rx="5" fill="rgba(201,169,110,0.07)" stroke="rgba(201,169,110,0.18)" stroke-width="1" />
    <text x="120"  y="407" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="13" fill="#9c9489">Memory</text>

    <rect x="202"  y="386" width="136" height="32" rx="5" fill="rgba(201,169,110,0.07)" stroke="rgba(201,169,110,0.18)" stroke-width="1" />
    <text x="270"  y="407" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="13" fill="#9c9489">Projects</text>

    <rect x="352"  y="386" width="136" height="32" rx="5" fill="rgba(201,169,110,0.07)" stroke="rgba(201,169,110,0.18)" stroke-width="1" />
    <text x="420"  y="407" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="13" fill="#9c9489">Artifacts</text>

    <rect x="502"  y="386" width="136" height="32" rx="5" fill="rgba(201,169,110,0.07)" stroke="rgba(201,169,110,0.18)" stroke-width="1" />
    <text x="570"  y="407" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="13" fill="#9c9489">Research</text>

    <!-- Row 2 of pills -->
    <rect x="52"   y="428" width="136" height="32" rx="5" fill="rgba(201,169,110,0.07)" stroke="rgba(201,169,110,0.18)" stroke-width="1" />
    <text x="120"  y="449" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="13" fill="#9c9489">Subagents</text>

    <rect x="202"  y="428" width="136" height="32" rx="5" fill="rgba(201,169,110,0.07)" stroke="rgba(201,169,110,0.18)" stroke-width="1" />
    <text x="270"  y="449" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="13" fill="#9c9489">Hooks</text>

    <rect x="352"  y="428" width="136" height="32" rx="5" fill="rgba(201,169,110,0.07)" stroke="rgba(201,169,110,0.18)" stroke-width="1" />
    <text x="420"  y="449" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="13" fill="#9c9489">Output Styles</text>

    <rect x="502"  y="428" width="136" height="32" rx="5" fill="rgba(201,169,110,0.07)" stroke="rgba(201,169,110,0.18)" stroke-width="1" />
    <text x="570"  y="449" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="13" fill="#9c9489">Permissions</text>

    <!-- connector: capabilities down to products -->
    <line x1="550" y1="486" x2="550" y2="516" stroke="rgba(201,169,110,0.18)" stroke-width="1" stroke-dasharray="4 3" />

    <!-- ════════════════════════════════════════════
         LAYER 2 — Products
    ═══════════════════════════════════════════════ -->
    <text x="32" y="508" font-family="'Outfit',system-ui,sans-serif" font-size="12" font-weight="500" letter-spacing="0.10em" fill="#5c5750">PRODUCTS</text>

    <!-- 8 tiles: each 118×72, gap 10, total = 8×118 + 7×10 = 1014, start x=32 -->
    <!-- Claude.ai -->
    <rect x="32"   y="520" width="118" height="72" rx="6" fill="#1a1815" stroke="rgba(255,255,255,0.09)" stroke-width="1" />
    <text x="91"   y="549" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="14" font-weight="600" fill="#e8e3db">Claude.ai</text>
    <text x="91"   y="570" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="11.5" fill="#5c5750">chat · web · mobile</text>

    <!-- Code -->
    <rect x="160"  y="520" width="118" height="72" rx="6" fill="#1a1815" stroke="rgba(255,255,255,0.09)" stroke-width="1" />
    <text x="219"  y="549" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="14" font-weight="600" fill="#e8e3db">Code</text>
    <text x="219"  y="570" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="11.5" fill="#5c5750">terminal agent</text>

    <!-- Cowork -->
    <rect x="288"  y="520" width="118" height="72" rx="6" fill="#1a1815" stroke="rgba(255,255,255,0.09)" stroke-width="1" />
    <text x="347"  y="549" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="14" font-weight="600" fill="#e8e3db">Cowork</text>
    <text x="347"  y="570" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="11.5" fill="#5c5750">desktop tasks</text>

    <!-- Chrome -->
    <rect x="416"  y="520" width="118" height="72" rx="6" fill="#1a1815" stroke="rgba(255,255,255,0.09)" stroke-width="1" />
    <text x="475"  y="549" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="14" font-weight="600" fill="#e8e3db">Chrome</text>
    <text x="475"  y="570" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="11.5" fill="#5c5750">browser agent</text>

    <!-- Excel -->
    <rect x="544"  y="520" width="118" height="72" rx="6" fill="#1a1815" stroke="rgba(255,255,255,0.09)" stroke-width="1" />
    <text x="603"  y="549" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="14" font-weight="600" fill="#e8e3db">Excel</text>
    <text x="603"  y="570" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="11.5" fill="#5c5750">spreadsheet agent</text>

    <!-- Design -->
    <rect x="672"  y="520" width="118" height="72" rx="6" fill="#1a1815" stroke="rgba(255,255,255,0.09)" stroke-width="1" />
    <text x="731"  y="549" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="14" font-weight="600" fill="#e8e3db">Design</text>
    <text x="731"  y="570" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="11.5" fill="#5c5750">visual work</text>

    <!-- Dispatch -->
    <rect x="800"  y="520" width="118" height="72" rx="6" fill="#1a1815" stroke="rgba(255,255,255,0.09)" stroke-width="1" />
    <text x="859"  y="549" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="14" font-weight="600" fill="#e8e3db">Dispatch</text>
    <text x="859"  y="570" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="11.5" fill="#5c5750">email · comms</text>

    <!-- Phone -->
    <rect x="928"  y="520" width="118" height="72" rx="6" fill="#1a1815" stroke="rgba(255,255,255,0.09)" stroke-width="1" />
    <text x="987"  y="549" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="14" font-weight="600" fill="#e8e3db">Phone</text>
    <text x="987"  y="570" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="11.5" fill="#5c5750">voice calls</text>

    <!-- faint connectors from products down to API -->
    <line x1="32"   y1="592" x2="32"   y2="630" stroke="rgba(255,255,255,0.05)" stroke-width="1" />
    <line x1="1068" y1="592" x2="1068" y2="630" stroke="rgba(255,255,255,0.05)" stroke-width="1" />
    <line x1="32"   y1="630" x2="1068" y2="630" stroke="rgba(255,255,255,0.05)" stroke-width="1" />

    <!-- ════════════════════════════════════════════
         LAYER 1 — API (bottom)
    ═══════════════════════════════════════════════ -->
    <rect x="32" y="648" width="1036" height="82" rx="6" fill="#211f1c" stroke="rgba(255,255,255,0.14)" stroke-width="1" />
    <text x="550" y="680" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="18" font-weight="600" fill="#e8e3db">API</text>
    <text x="550" y="706" text-anchor="middle" font-family="'Outfit',system-ui,sans-serif" font-size="13" fill="#9c9489">the model underneath everything</text>

    <!-- left-edge layer depth markers -->
    <line x1="14" y1="92"  x2="14" y2="188" stroke="rgba(255,255,255,0.07)" stroke-width="1" />
    <line x1="14" y1="346" x2="14" y2="490" stroke="rgba(201,169,110,0.20)" stroke-width="1" />
    <line x1="14" y1="506" x2="14" y2="596" stroke="rgba(255,255,255,0.07)" stroke-width="1" />
    <line x1="14" y1="646" x2="14" y2="732" stroke="rgba(255,255,255,0.07)" stroke-width="1" />
  </svg>
</figure>
